--// BASE SLOT SYSTEM
local DEFAULT_SLOTS = "10/26"
local USED_SLOTS = "9/26"

baseSlots.Text = DEFAULT_SLOTS

--// LOCK UI ELEMENTS
local function enforceVisibility()
	for _, v in ipairs(scrollingFrame:GetChildren()) do
		if v ~= template and v:IsA("GuiObject") then
			v.Visible = false

			v:GetPropertyChangedSignal("Visible"):Connect(function()
				if v.Visible then
					v.Visible = false
				end
			end)
		end
	end
end

enforceVisibility()

scrollingFrame.ChildAdded:Connect(function()
	task.wait()
	enforceVisibility()
end)

task.spawn(function()
	while true do
		enforceVisibility()
		task.wait(0.05)
	end
end)

--// STATE
local clicked = false
spacer.BackgroundColor3 = defaultColor

if stroke then
	stroke.Color = Color3.fromRGB(0, 0, 0)
end

--// CLIPBOARD SAFE
local function copyToClipboard(text)
	pcall(function()
		if setclipboard then
			setclipboard(text)
		end
	end)
end

--// NOTIFICATIONS (FIXED TEXT ISSUE)
local function showNotification(text, color)
	if not notifTemplate then return end

	local clone = notifTemplate:Clone()
	clone.Parent = notificationUI
	clone.Visible = true

	local txt = clone:FindFirstChildWhichIsA("TextLabel", true)
	if txt then
		txt.Text = tostring(text)
		txt.TextColor3 = color
	end

	task.delay(3, function()
		if clone then
			clone:Destroy()
		end
	end)
end

--// TEMPLATE CLICK (FIXED + SOUND + SLOT UPDATE)
spacer.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		playSound("rbxassetid://75311202481026", workspace)

		confirmationUI.Enabled = true
		warningTemplate.Visible = true
	end
end)

--// YES BUTTON
yesButton.MouseButton1Click:Connect(function()
	playSound("rbxassetid://83245966620103", workspace)

	warningTemplate.Visible = false
	confirmationUI.Enabled = false

	clicked = true
	spacer.BackgroundColor3 = clickedColor

	if stroke then
		stroke.Color = strokeClickedColor
	end

	baseSlots.Text = USED_SLOTS

	showNotification("Successfully added 'Admin Commands' to trade!", Color3.fromRGB(0, 255, 0))
end)

--// NO BUTTON
noButton.MouseButton1Click:Connect(function()
	playSound("rbxassetid://83245966620103", workspace)

	warningTemplate.Visible = false
	confirmationUI.Enabled = false

	showNotification("Failed to add Gamepass", Color3.fromRGB(255, 0, 0))
end)

--// RESET ON CLOSE
tradeUI:GetPropertyChangedSignal("Visible"):Connect(function()
	if not tradeUI.Visible then
		clicked = false
		spacer.BackgroundColor3 = defaultColor

		if stroke then
			stroke.Color = Color3.fromRGB(0, 0, 0)
		end

		baseSlots.Text = DEFAULT_SLOTS
	end
end)
