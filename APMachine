--// FUNCTIONS
--////////////////////////////////////////////////////

local spawnedTemplates = {}

local function showNotification(text, color)
	local templateClone = notifTemplate:Clone()
	templateClone.Parent = notificationUI
	templateClone.Visible = true

	local txt = templateClone:FindFirstChild("Text", true)

	if txt then
		txt.Text = text
		txt.TextColor3 = color
	end

	task.delay(5, function()
		if templateClone then
			templateClone:Destroy()
		end
	end)
end

local function updateCount()
	countBox.Text = tostring(#spawnedTemplates)
end

-- Hide Selection objects forever
local function hideSelections()
	for _, v in ipairs(scrollingFrame:GetDescendants()) do
		if string.find(v.Name, "Selection") then
			if v:IsA("GuiObject") then
				v.Visible = false
			end
		end
	end
end

task.spawn(function()
	while true do
		hideSelections()
		task.wait(0.05)
	end
end)

--////////////////////////////////////////////////////
--// TEMPLATE CREATION
--////////////////////////////////////////////////////

local function setupTemplate(clone)
	local spacerClone = clone:WaitForChild("Spacer")

	local cash = spacerClone:WaitForChild("Cash")
	local titleLabel = spacerClone:WaitForChild("Title")
	local stroke = spacerClone:FindFirstChildOfClass("UIStroke")

	cash.Text = "9,999"
	titleLabel.Text = "[🎁] Admin Panel"

	if not spacerClone:FindFirstChild("CustomImage") then
		local image = Instance.new("ImageLabel")
		image.Name = "CustomImage"
		image.Parent = spacerClone
		image.BackgroundTransparency = 1
		image.Image = "rbxassetid://139291316302932"
		image.Size = UDim2.new(0.5, 0, 0.5, 0)
		image.Position = UDim2.new(0.25, 0, 0.25, 0)
	end

	local clicked = false
	local holding = false

	spacerClone.BackgroundColor3 = defaultColor

	if stroke then
		stroke.Color = Color3.fromRGB(0,0,0)
	end

	local function reset()
		clicked = false
		holding = false

		spacerClone.BackgroundColor3 = defaultColor

		if stroke then
			stroke.Color = Color3.fromRGB(0,0,0)
		end
	end

	local function isAccepted()
		local other = tradeUI:FindFirstChild("Other")
		if not other then return false end

		local readyButton = other:FindFirstChild("ReadyButton")
		if not readyButton then return false end

		local txt = readyButton:FindFirstChild("Txt")
		if not txt then return false end

		return txt.Text == "ACCEPT"
	end

	task.spawn(function()
		while clone.Parent do
			if isAccepted() then
				reset()
			end
			task.wait(0.05)
		end
	end)

	spacerClone.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			holding = true

			if clicked then
				spacerClone.BackgroundColor3 = holdColor
			end
		end
	end)

	spacerClone.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			if not holding then return end

			holding = false

			clickSound:Play()

			if clicked then
				clicked = false

				spacerClone.BackgroundColor3 = defaultColor

				if stroke then
					stroke.Color = Color3.fromRGB(0,0,0)
				end

				failSound:Play()

				showNotification(
					"Failed to add 'Admin Panel' to trade!",
					Color3.fromRGB(255,0,0)
				)

				return
			end

			confirmationUI.Enabled = true
			warningTemplate.Visible = true

			local yesConn
			local noConn

			yesConn = yesButton.MouseButton1Click:Connect(function()
				yesConn:Disconnect()
				noConn:Disconnect()

				warningTemplate.Visible = false
				confirmationUI.Enabled = false

				yesSound:Play()

				clicked = true

				spacerClone.BackgroundColor3 = clickedColor

				if stroke then
					stroke.Color = strokeClickedColor
				end

				showNotification(
					"Successfully added 'Admin Panel' to trade!",
					Color3.fromRGB(0,255,0)
				)
			end)

			noConn = noButton.MouseButton1Click:Connect(function()
				yesConn:Disconnect()
				noConn:Disconnect()

				warningTemplate.Visible = false
				confirmationUI.Enabled = false

				failSound:Play()

				showNotification(
					"Failed to add 'Admin Panel' to trade!",
					Color3.fromRGB(255,0,0)
				)
			end)
		end
	end)
end

--////////////////////////////////////////////////////
--// BUTTONS
--////////////////////////////////////////////////////

createButton.MouseButton1Click:Connect(function()
	local clone = template:Clone()
	clone.Name = "AdminPanel_" .. tostring(#spawnedTemplates + 1)
	clone.Visible = true
	clone.Parent = scrollingFrame

	setupTemplate(clone)

	table.insert(spawnedTemplates, clone)

	updateCount()

	showNotification(
		"Spawned Admin Panel!",
		Color3.fromRGB(0,255,0)
	)
end)

deleteButton.MouseButton1Click:Connect(function()
	for _, v in ipairs(spawnedTemplates) do
		if v and v.Parent then
			v:Destroy()
		end
	end

	table.clear(spawnedTemplates)

	updateCount()

	showNotification(
		"Deleted all Admin Panels!",
		Color3.fromRGB(255,0,0)
	)
end)

countBox.FocusLost:Connect(function()
	local target = tonumber(countBox.Text)

	if not target then
		updateCount()
		return
	end

	target = math.max(0, math.floor(target))

	while #spawnedTemplates < target do
		createButton:Activate()
	end

	while #spawnedTemplates > target do
		local obj = table.remove(spawnedTemplates)

		if obj and obj.Parent then
			obj:Destroy()
		end
	end

	updateCount()
end)

-- Reset when trade closes
tradeUI:GetPropertyChangedSignal("Visible"):Connect(function()
	if not tradeUI.Visible then
		for _, clone in ipairs(spawnedTemplates) do
			if clone and clone.Parent then
				local spacerClone = clone:FindFirstChild("Spacer")

				if spacerClone then
					spacerClone.BackgroundColor3 = defaultColor

					local stroke = spacerClone:FindFirstChildOfClass("UIStroke")

					if stroke then
						stroke.Color = Color3.fromRGB(0,0,0)
					end
				end
			end
		end
	end
end)
