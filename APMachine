-- CREATE PANEL
local function createAdminPanel()
	local clone = template:Clone()
	clone.Name = "AdminPanel"
	clone.Visible = true
	clone.Parent = scrollingFrame

	local spacerClone = clone:WaitForChild("Spacer")

	local cash = spacerClone:WaitForChild("Cash")
	local title = spacerClone:WaitForChild("Title")
	local strokeObj = spacerClone:FindFirstChildOfClass("UIStroke")

	cash.Text = "9,999"
	title.Text = "[🎁] Admin Panel"

	if not spacerClone:FindFirstChild("CustomImage") then
		local image = Instance.new("ImageLabel")
		image.Name = "CustomImage"
		image.Parent = spacerClone
		image.BackgroundTransparency = 1
		image.Image = "rbxassetid://139291316302932"
		image.Size = UDim2.new(0.5, 0, 0.5, 0)
		image.Position = UDim2.new(0.25, 0, 0.25, 0)
	end

	local clicked = false
	local holding = false

	spacerClone.BackgroundColor3 = defaultColor

	if strokeObj then
		strokeObj.Color = Color3.fromRGB(0,0,0)
	end

	local function reset()
		clicked = false
		holding = false

		spacerClone.BackgroundColor3 = defaultColor

		if strokeObj then
			strokeObj.Color = Color3.fromRGB(0,0,0)
		end
	end

	spacerClone.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			holding = true

			if clicked then
				spacerClone.BackgroundColor3 = holdColor
			end
		end
	end)

	spacerClone.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			if not holding then
				return
			end

			holding = false

			clickSound:Play()

			if clicked then
				clicked = false

				spacerClone.BackgroundColor3 = defaultColor

				if strokeObj then
					strokeObj.Color = Color3.fromRGB(0,0,0)
				end

				failSound:Play()

				showNotification(
					"<font color='#ff0000'>Failed to add 'Admin Panel' to trade!</font>",
					Color3.fromRGB(255,0,0)
				)

				return
			end

			confirmationUI.Enabled = true
			warningTemplate.Visible = true

			local yesConn
			local noConn

			yesConn = yesButton.MouseButton1Click:Connect(function()
				yesConn:Disconnect()
				if noConn then
					noConn:Disconnect()
				end

				warningTemplate.Visible = false
				confirmationUI.Enabled = false

				yesSound:Play()

				clicked = true

				spacerClone.BackgroundColor3 = clickedColor

				if strokeObj then
					strokeObj.Color = strokeClickedColor
				end

				showNotification(
					"<font color='#00ff00'>Successfully added 'Admin Panel' to trade!</font>",
					Color3.fromRGB(0,255,0)
				)
			end)

			noConn = noButton.MouseButton1Click:Connect(function()
				noConn:Disconnect()
				if yesConn then
					yesConn:Disconnect()
				end

				warningTemplate.Visible = false
				confirmationUI.Enabled = false

				failSound:Play()

				showNotification(
					"<font color='#ff0000'>Failed to add 'Admin Panel' to trade!</font>",
					Color3.fromRGB(255,0,0)
				)
			end)
		end
	end)

	table.insert(adminPanels, clone)

	amountBox.Text = tostring(#adminPanels)
end

-- REMOVE PANEL
local function removeAdminPanel()
	local panel = adminPanels[#adminPanels]

	if panel then
		panel:Destroy()
		table.remove(adminPanels, #adminPanels)
	end

	amountBox.Text = tostring(#adminPanels)
end

-- BUTTONS
addButton.MouseButton1Click:Connect(function()
	createAdminPanel()
end)

removeButton.MouseButton1Click:Connect(function()
	removeAdminPanel()
end)

-- TEXTBOX CONTROL
amountBox.FocusLost:Connect(function()
	local num = tonumber(amountBox.Text)

	if not num then
		amountBox.Text = tostring(#adminPanels)
		return
	end

	num = math.clamp(math.floor(num), 0, 100)

	while #adminPanels < num do
		createAdminPanel()
	end

	while #adminPanels > num do
		removeAdminPanel()
	end

	amountBox.Text = tostring(#adminPanels)
end)
