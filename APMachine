-- DRAGGING
local dragging = false
local dragInput, dragStart, startPos

local function update(input)
	local delta = input.Position - dragStart
	mainFrame.Position = UDim2.new(
		startPos.X.Scale,
		startPos.X.Offset + delta.X,
		startPos.Y.Scale,
		startPos.Y.Offset + delta.Y
	)
end

mainFrame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		startPos = mainFrame.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

mainFrame.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement then
		dragInput = input
	end
end)

game:GetService("UserInputService").InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		update(input)
	end
end)

-- =========================
-- 🔁 CLONE ADMIN PANEL
-- =========================

local function makePanelFunctional(newTemplate)
	local newSpacer = newTemplate:WaitForChild("Spacer")

	local newCash = newSpacer:WaitForChild("Cash")
	local newTitle = newSpacer:WaitForChild("Title")
	local newStroke = newSpacer:FindFirstChildOfClass("UIStroke")

	newCash.Text = "9,999"
	newTitle.Text = "[🎁] Admin Panel"

	local newClicked = false
	local newHolding = false

	-- sounds
	local newClickSound = clickSound:Clone()
	newClickSound.Parent = newSpacer

	local newYesSound = yesSound:Clone()
	newYesSound.Parent = newTemplate

	local newFailSound = failSound:Clone()
	newFailSound.Parent = newTemplate

	-- input
	newSpacer.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			newHolding = true
			if newClicked then
				newSpacer.BackgroundColor3 = holdColor
			end
		end
	end)

	newSpacer.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			if not newHolding then return end
			newHolding = false

			newClickSound:Play()

			if newClicked then
				newClicked = false
				newSpacer.BackgroundColor3 = defaultColor

				if newStroke then
					newStroke.Color = Color3.fromRGB(0,0,0)
				end

				newFailSound:Play()

				showNotification(
					"Failed to add 'Admin Panel' to trade!",
					Color3.fromRGB(255,0,0)
				)

				return
			end

			confirmationUI.Enabled = true
			warningTemplate.Visible = true

			yesButton.MouseButton1Click:Once(function()
				newClicked = true
				newSpacer.BackgroundColor3 = clickedColor

				if newStroke then
					newStroke.Color = strokeClickedColor
				end

				showNotification(
					"Successfully added 'Admin Panel' to trade!",
					Color3.fromRGB(0,255,0)
				)
			end)
		end
	end)
end

