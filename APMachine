--// LOCK OTHER UI ELEMENTS
local function enforceVisibility()
	for _, v in ipairs(scrollingFrame:GetChildren()) do
		if v ~= template and v:IsA("GuiObject") then
			v.Visible = false

			v:GetPropertyChangedSignal("Visible"):Connect(function()
				if v.Visible then
					v.Visible = false
				end
			end)
		end
	end
end

enforceVisibility()

scrollingFrame.ChildAdded:Connect(function()
	task.wait()
	enforceVisibility()
end)

task.spawn(function()
	while true do
		enforceVisibility()
		task.wait(0.05)
	end
end)

--// STATE
spacer.BackgroundColor3 = defaultColor
if stroke then
	stroke.Color = Color3.fromRGB(0, 0, 0)
end

local clicked = false

--// CLIPBOARD SAFE
local function copyToClipboard(text)
	pcall(function()
		if setclipboard then
			setclipboard(text)
		end
	end)
end

--// NOTIFICATION SYSTEM (SAFE + NO INFINITE YIELD)
local function showNotification(text, color)
	local template = notificationUI:FindFirstChild("Template")
	if not template then
		template = notificationUI:WaitForChild("Template", 3)
	end

	if not template then
		warn("Notification Template missing")
		copyToClipboard("Notification Template missing")
		return
	end

	local clone = template:Clone()
	clone.Parent = notificationUI
	clone.Visible = true

	local txt = clone:FindFirstChildWhichIsA("TextLabel", true)
	if txt then
		txt.Text = text
		txt.TextColor3 = color
	end

	task.delay(3, function()
		if clone then
			clone:Destroy()
		end
	end)
end

--// OPEN CONFIRMATION
spacer.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		confirmationUI.Enabled = true
		warningTemplate.Visible = true
	end
end)

--// YES BUTTON
yesButton.MouseButton1Click:Connect(function()
	warningTemplate.Visible = false
	confirmationUI.Enabled = false

	clicked = true
	spacer.BackgroundColor3 = clickedColor

	if stroke then
		stroke.Color = strokeClickedColor
	end

	showNotification(
		"Sucessfully added 'Admin Commands' to trade!",
		Color3.fromRGB(0, 255, 0)
	)
end)

