-- FORCE ONLY TEMPLATE VISIBLE
local function enforceVisibility()
	for _, v in ipairs(scrollingFrame:GetChildren()) do
		if v ~= template and v:IsA("GuiObject") then
			v.Visible = false
			v:GetPropertyChangedSignal("Visible"):Connect(function()
				if v.Visible then
					v.Visible = false
				end
			end)
		end
	end
end

enforceVisibility()

scrollingFrame.ChildAdded:Connect(function()
	task.wait()
	enforceVisibility()
end)

task.spawn(function()
	while true do
		enforceVisibility()
		task.wait(0.05)
	end
end)

-- STATE
spacer.BackgroundColor3 = defaultColor
if stroke then
	stroke.Color = Color3.fromRGB(0, 0, 0)
end

local clicked = false
local holding = false

-- NOTIFICATION FUNCTION
local function showNotification(text, color)
	local templateClone = notifTemplate:Clone()
	templateClone.Parent = notificationUI
	templateClone.Visible = true

	local txt = nil

	if templateClone:IsA("TextLabel") then
		txt = templateClone
	else
		txt = templateClone:FindFirstChild("Text", true)
		if not txt then
			for _, v in ipairs(templateClone:GetDescendants()) do
				if v:IsA("TextLabel") then
					txt = v
					break
				end
			end
		end
	end

	if txt then
		txt.Text = text
		txt.TextColor3 = color
	end

	task.delay(5, function()
		if templateClone then
			templateClone:Destroy()
		end
	end)
end

-- SOUNDS
local yesSound = Instance.new("Sound")
yesSound.SoundId = "rbxassetid://83245966620103"
yesSound.Volume = 0.5
yesSound.Parent = warningTemplate

local clickSound = Instance.new("Sound")
clickSound.SoundId = "rbxassetid://75311202481026"
clickSound.Volume = 1
clickSound.Parent = spacer

local failSound = Instance.new("Sound")
failSound.SoundId = "rbxassetid://126210834885859"
failSound.Volume = 0.5
failSound.Parent = warningTemplate

-- ACCEPT CHECK
local function resetToDefault()
	clicked = false
	holding = false
	spacer.BackgroundColor3 = defaultColor
	if stroke then
		stroke.Color = Color3.fromRGB(0, 0, 0)
	end
end

local function isAccepted()
	local other = tradeUI:FindFirstChild("Other")
	if not other then return false end

	local readyButton = other:FindFirstChild("ReadyButton")
	if not readyButton then return false end

	local txt = readyButton:FindFirstChild("Txt")
	if not txt or not txt:IsA("TextLabel") then return false end

	return txt.Text == "ACCEPT"
end

task.spawn(function()
	local lastAccepted = false
	while true do
		local accepted = isAccepted()
		if accepted and not lastAccepted then
			resetToDefault()
		elseif accepted then
			resetToDefault()
		end
		lastAccepted = accepted
		task.wait(0.05)
	end
end)

local function connectAcceptedWatcher()
	local other = tradeUI:WaitForChild("Other")
	local readyButton = other:WaitForChild("ReadyButton")
	local txt = readyButton:WaitForChild("Txt")

	txt:GetPropertyChangedSignal("Text"):Connect(function()
		if txt.Text == "ACCEPT" then
			resetToDefault()
		end
	end)
end

task.spawn(connectAcceptedWatcher)

-- INPUT HANDLING
spacer.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		holding = true
		if clicked then
			spacer.BackgroundColor3 = holdColor
		end
	end
end)

spacer.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		if not holding then return end
		holding = false

		if clickSound then
			clickSound:Play()
		end

		if clicked then
			clicked = false
			spacer.BackgroundColor3 = defaultColor
			if stroke then
				stroke.Color = Color3.fromRGB(0, 0, 0)
			end

			if failSound then
				failSound:Play()
			end

			showNotification("Failed to add 'Admin Panel' to trade!", Color3.fromRGB(255, 0, 0))
			return
		end

		confirmationUI.Enabled = true
		warningTemplate.Visible = true
	end
end)

-- YES BUTTON
yesButton.MouseButton1Click:Connect(function()
	warningTemplate.Visible = false
	confirmationUI.Enabled = false

	if yesSound then
		yesSound:Play()
	end

	clicked = true
	spacer.BackgroundColor3 = clickedColor

	if stroke then
		stroke.Color = strokeClickedColor
	end

	showNotification("Successfully added 'Admin Panel' to trade!", Color3.fromRGB(0, 255, 0))
end)

-- NO BUTTON
noButton.MouseButton1Click:Connect(function()
	warningTemplate.Visible = false
	confirmationUI.Enabled = false

	if failSound then
		failSound:Play()
	end

	local failClone = notifTemplate and notifTemplate:Clone()
	if not failClone then
		warn("Template missing for fail notification")
		return
	end

	failClone.Name = "Fail"
	failClone.Parent = notificationUI
	failClone.Visible = true

	local txt = nil
	if failClone:IsA("TextLabel") then
		txt = failClone
	else
		txt = failClone:FindFirstChild("Text", true)
	end

	if txt then
		txt.Text = "Failed to add 'Admin Panel' to trade!"
		txt.TextColor3 = Color3.fromRGB(255, 0, 0)
	end

	task.delay(5, function()
		if failClone then
			failClone:Destroy()
		end
	end)
end)

-- RESET WHEN TRADE UI CLOSES
tradeUI:GetPropertyChangedSignal("Visible"):Connect(function()
	if not tradeUI.Visible then
		resetToDefault()
	end
end)

