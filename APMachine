--// ⭐ FINAL NOTIFICATION FIX
local function showNotification(text, color)
	local template = notificationRoot:WaitForChild("Notification"):WaitForChild("Template")

	local clone = template:Clone()
	clone.Parent = notificationUI
	clone.Visible = true

	local txt = nil

	-- CASE 1: Template itself is a TextLabel
	if clone:IsA("TextLabel") then
		txt = clone
	else
		-- CASE 2: Try named "Text"
		txt = clone:FindFirstChild("Text", true)

		-- CASE 3: fallback scan
		if not txt then
			for _, v in ipairs(clone:GetDescendants()) do
				if v:IsA("TextLabel") then
					txt = v
					break
				end
			end
		end
	end

	if txt then
		txt.Text = text
		txt.TextColor3 = color
	else
		warn("Notification text object not found")
	end

	task.delay(5, function()
		if clone then
			clone:Destroy()
		end
	end)
end

