--====================================================
-- TEMPLATE FUNCTIONALITY
--====================================================

local function setupPanel(panel)
	local panelSpacer = panel:WaitForChild("Spacer")

	local cash = panelSpacer:WaitForChild("Cash")
	local titleText = panelSpacer:WaitForChild("Title")
	local panelStroke = panelSpacer:FindFirstChildOfClass("UIStroke")

	cash.Text = "9,999"
	titleText.Text = "[🎁] Admin Panel"

	description.Text =
	"The other player will not see this item in the trade but will still receive the item. Do you still want to add this item to the trade?"

	if not panelSpacer:FindFirstChild("CustomImage") then
		local image = Instance.new("ImageLabel")
		image.Name = "CustomImage"
		image.Parent = panelSpacer
		image.BackgroundTransparency = 1
		image.Image = "rbxassetid://139291316302932"
		image.Size = UDim2.new(0.5, 0, 0.5, 0)
		image.Position = UDim2.new(0.25, 0, 0.25, 0)
	end

	local defaultColor = Color3.fromRGB(35,45,50)
	local clickedColor = Color3.fromRGB(15,50,15)
	local holdColor = Color3.fromRGB(81,103,81)
	local strokeClickedColor = Color3.fromRGB(15,255,15)

	panelSpacer.BackgroundColor3 = defaultColor

	local clicked = false
	local holding = false

	panelSpacer.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			holding = true

			if clicked then
				panelSpacer.BackgroundColor3 = holdColor
			end
		end
	end)

	panelSpacer.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			if not holding then
				return
			end

			holding = false

			if clicked then
				clicked = false
				panelSpacer.BackgroundColor3 = defaultColor

				if panelStroke then
					panelStroke.Color = Color3.fromRGB(0,0,0)
				end

				notify(
					"Failed to add 'Admin Panel' to trade!",
					Color3.fromRGB(255,0,0)
				)

				return
			end

			confirmationUI.Enabled = true
			warningTemplate.Visible = true

			local yesConn
			local noConn

			yesConn = yesButton.MouseButton1Click:Connect(function()
				yesConn:Disconnect()
				noConn:Disconnect()

				warningTemplate.Visible = false
				confirmationUI.Enabled = false

				clicked = true
				panelSpacer.BackgroundColor3 = clickedColor

				if panelStroke then
					panelStroke.Color = strokeClickedColor
				end

				notify(
					"Successfully added 'Admin Panel' to trade!",
					Color3.fromRGB(0,255,0)
				)
			end)

			noConn = noButton.MouseButton1Click:Connect(function()
				yesConn:Disconnect()
				noConn:Disconnect()

				warningTemplate.Visible = false
				confirmationUI.Enabled = false

				notify(
					"Failed to add 'Admin Panel' to trade!",
					Color3.fromRGB(255,0,0)
				)
			end)
		end
	end)
end

--====================================================
-- CREATE PANEL
--====================================================

createButton.MouseButton1Click:Connect(function()
	local clone = template:Clone()
	clone.Name = "AdminPanel_"..tostring(#adminPanels + 1)
	clone.Visible = true
	clone.Parent = scrollingFrame

	setupPanel(clone)

	table.insert(adminPanels, clone)

	updateCount()

	notify(
		"Spawned Admin Panel!",
		Color3.fromRGB(0,255,255)
	)
end)

--====================================================
-- DELETE PANELS
--====================================================

deleteButton.MouseButton1Click:Connect(function()
	for _, v in ipairs(adminPanels) do
		if v then
			v:Destroy()
		end
	end

	adminPanels = {}

	updateCount()

	notify(
		"Deleted all Admin Panels!",
		Color3.fromRGB(255,80,80)
	)
end)

--====================================================
-- RESET ON TRADE CLOSE
--====================================================

tradeUI:GetPropertyChangedSignal("Visible"):Connect(function()
	if not tradeUI.Visible then
		for _, v in ipairs(adminPanels) do
			if v then
				v:Destroy()
			end
		end

		adminPanels = {}
		updateCount()
	end
end)

updateCount()
