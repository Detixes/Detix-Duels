--// SERVICES
local player = game.Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

--// TRADE UI
local tradeRoot = playerGui:WaitForChild("TradeLiveTrade")
local tradeUI = tradeRoot:WaitForChild("TradeLiveTrade")

local yourFrame = tradeUI:WaitForChild("Your")
local scrollingFrame = yourFrame:WaitForChild("ScrollingFrame")

local template = scrollingFrame:WaitForChild("Template")
local spacer = template:WaitForChild("Spacer")

local cash = spacer:WaitForChild("Cash")
local title = spacer:WaitForChild("Title")
local stroke = spacer:FindFirstChildOfClass("UIStroke")

--// BASE SLOTS
local baseSlots = tradeUI:WaitForChild("BaseSlots")

--// CONFIRMATION UI
local confirmationUI = playerGui:WaitForChild("Confirmation")
local warningTemplate = confirmationUI:WaitForChild("WarningTemplate")

local content = warningTemplate:WaitForChild("Content")
local description = content:WaitForChild("Description")

local yesButton = warningTemplate:WaitForChild("Yes")
local noButton = warningTemplate:WaitForChild("No")

--// NOTIFICATION UI
local notificationRoot = playerGui:WaitForChild("Notification")
local notificationUI = notificationRoot:WaitForChild("Notification")

local notifTemplate = notificationUI:WaitForChild("Template", 5)

--// COLORS
local defaultColor = Color3.fromRGB(35, 45, 50)
local clickedColor = Color3.fromRGB(15, 50, 60)
local strokeClickedColor = Color3.fromRGB(0, 0, 70)

--// INIT
cash.Text = "0/s"
title.Text = "Test"
description.Text =
"The other player will not see this item in the trade but will still receive the item. Do you still want to add this item to the trade?"

--// IMAGE
if not spacer:FindFirstChild("CustomImage") then
	local image = Instance.new("ImageLabel")
	image.Name = "CustomImage"
	image.Parent = spacer
	image.BackgroundTransparency = 1
	image.Image = "rbxassetid://139291316302932"
	image.Size = UDim2.new(0.5, 0, 0.5, 0)
	image.Position = UDim2.new(0.25, 0, 0.25, 0)
end

--// SOUND FUNCTION
local function playSound(id)
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = 1
	sound.Parent = tradeUI
	sound:Play()
	game:GetService("Debris"):AddItem(sound, 3)
end

--// BASE SLOT STATE
local maxSlots = 26
local currentSlots = 10

local function updateSlots()
	baseSlots.Text = tostring(currentSlots) .. "/" .. tostring(maxSlots)
end

updateSlots()

--// FORCE TEMPLATE VISIBLE
template.Visible = true
spacer.Visible = true

--// LOCK OTHER UI ELEMENTS
local function enforceVisibility()
	for _, v in ipairs(scrollingFrame:GetChildren()) do
		if v ~= template and v:IsA("GuiObject") then
			v.Visible = false

			v:GetPropertyChangedSignal("Visible"):Connect(function()
				if v.Visible then
					v.Visible = false
				end
			end)
		end
	end
end

enforceVisibility()

scrollingFrame.ChildAdded:Connect(function()
	task.wait()
	enforceVisibility()
end)

task.spawn(function()
	while true do
		enforceVisibility()
		task.wait(0.05)
	end
end)

--// STATE
spacer.BackgroundColor3 = defaultColor
if stroke then
	stroke.Color = Color3.fromRGB(0, 0, 0)
end

local clicked = false

--// CLIPBOARD SAFE
local function copyToClipboard(text)
	pcall(function()
		if setclipboard then
			setclipboard(text)
		end
	end)
end

--// NOTIFICATION SYSTEM (FIXED TEXT)
local function showNotification(text, color)
	local template = notificationUI:FindFirstChild("Template")
	if not template then return end

	local clone = template:Clone()
	clone.Parent = notificationUI
	clone.Visible = true

	local label = clone:FindFirstChildWhichIsA("TextLabel", true)
	if label then
		label.Text = text
		label.TextColor3 = color
	else
		clone.Text = text -- fallback
	end

	task.delay(3, function()
		if clone then
			clone:Destroy()
		end
	end)
end

--// TEMPLATE CLICK
spacer.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		playSound("rbxassetid://75311202481026")

		confirmationUI.Enabled = true
		warningTemplate.Visible = true
	end
end)

--// YES BUTTON
yesButton.MouseButton1Click:Connect(function()
	playSound("rbxassetid://83245966620103")

	warningTemplate.Visible = false
	confirmationUI.Enabled = false

	clicked = true
	spacer.BackgroundColor3 = clickedColor

	if stroke then
		stroke.Color = strokeClickedColor
	end

	-- decrease slots
	if currentSlots > 0 then
		currentSlots -= 1
		updateSlots()
	end

	showNotification(
		"Successfully added 'Admin Commands' to trade!",
		Color3.fromRGB(0, 255, 0)
	)
end)

--// NO BUTTON
noButton.MouseButton1Click:Connect(function()
	playSound("rbxassetid://83245966620103")

	warningTemplate.Visible = false
	confirmationUI.Enabled = false

	local failClone = notifTemplate and notifTemplate:Clone()
	if not failClone then return end

	failClone.Parent = notificationUI
	failClone.Visible = true

	local txt = failClone:FindFirstChildWhichIsA("TextLabel", true)
	if txt then
		txt.Text = "Failed to add Gamepass"
		txt.TextColor3 = Color3.fromRGB(255, 0, 0)
	end

	copyToClipboard("Failed to add Gamepass")

	task.delay(3, function()
		if failClone then
			failClone:Destroy()
		end
	end)
end)

--// RESET ON UI CLOSE
tradeUI:GetPropertyChangedSignal("Visible"):Connect(function()
	if not tradeUI.Visible then
		clicked = false
		spacer.BackgroundColor3 = defaultColor

		if stroke then
			stroke.Color = Color3.fromRGB(0, 0, 0)
		end

		-- reset slots
		currentSlots = 10
		updateSlots()
	end
end)
