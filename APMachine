-- HIDE SELECTIONS
local function hideSelections()
	for _, v in ipairs(scrollingFrame:GetChildren()) do
		if string.find(v.Name, "Selection") then
			if v:IsA("GuiObject") then
				v.Visible = false
			end
		end
	end
end

task.spawn(function()
	while true do
		hideSelections()
		task.wait(0.05)
	end
end)

-- NOTIFICATIONS
local function showNotification(text, color)
	local clone = notifTemplate:Clone()
	clone.Visible = true
	clone.Parent = notificationUI

	local txt = nil

	if clone:IsA("TextLabel") then
		txt = clone
	else
		txt = clone:FindFirstChild("Text", true)
	end

	if txt then
		txt.RichText = true
		txt.Text = text
		txt.TextColor3 = color
	end

	task.delay(5, function()
		if clone then
			clone:Destroy()
		end
	end)
end

