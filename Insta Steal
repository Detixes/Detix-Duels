--// Dragon Canneloni 312M
--// LocalScript

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ProximityPromptService = game:GetService("ProximityPromptService")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

--// GUI
local gui = Instance.new("ScreenGui")
gui.Name = "DragonCanneloniUI"
gui.ResetOnSpawn = false
gui.Parent = game.CoreGui

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 260, 0, 90)
frame.Position = UDim2.new(0.5, -130, 0.5, -45)
frame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
frame.BorderSizePixel = 0
frame.Active = true
frame.Draggable = true
frame.Parent = gui

local frameCorner = Instance.new("UICorner")
frameCorner.CornerRadius = UDim.new(0, 10)
frameCorner.Parent = frame

local title = Instance.new("TextLabel")
title.Size = UDim2.new(0, 170, 1, 0)
title.BackgroundTransparency = 1
title.Text = "Dragon Canneloni 312M"
title.TextColor3 = Color3.new(1,1,1)
title.TextScaled = true
title.Font = Enum.Font.GothamBold
title.Parent = frame

local button = Instance.new("TextButton")
button.Size = UDim2.new(0, 70, 0, 40)
button.Position = UDim2.new(1, -80, 0.5, -20)
button.BackgroundColor3 = Color3.fromRGB(0,170,255)
button.Text = "Start"
button.TextColor3 = Color3.new(1,1,1)
button.TextScaled = true
button.Font = Enum.Font.GothamBold
button.Parent = frame

local buttonCorner = Instance.new("UICorner")
buttonCorner.CornerRadius = UDim.new(0,8)
buttonCorner.Parent = button

--// Instant prompts
ProximityPromptService.PromptShown:Connect(function(prompt)
    prompt.HoldDuration = 0
    prompt.RequiresLineOfSight = false
end)

--// Noclip
local noclipConnection

local function enableNoclip(character)
    if noclipConnection then
        noclipConnection:Disconnect()
    end

    noclipConnection = RunService.Stepped:Connect(function()
        for _, v in pairs(character:GetDescendants()) do
            if v:IsA("BasePart") then
                v.CanCollide = false
            end
        end
    end)
end

--// Main
button.MouseButton1Click:Connect(function()

    local character = player.Character or player.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid")
    local hrp = character:WaitForChild("HumanoidRootPart")

    -- Equip first tool
    local backpack = player:WaitForChild("Backpack")
    local firstTool = backpack:FindFirstChildWhichIsA("Tool")

    if firstTool then
        humanoid:EquipTool(firstTool)

        -- Wait until equipped
        repeat
            task.wait()
        until character:FindFirstChild(firstTool.Name)
    end

    -- First teleport
    hrp.CFrame = CFrame.new(-338.11, 16.01, -5.19)

    humanoid.WalkSpeed = 29

    -- Find and trigger ONE nearby prompt
    local triggered = false
    local radius = 25

    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Parent then

            local parentPart = obj.Parent

            if parentPart:IsA("BasePart") then
                local distance = (hrp.Position - parentPart.Position).Magnitude

                if distance <= radius then
                    obj.HoldDuration = 0
                    obj.RequiresLineOfSight = false

                    pcall(function()
                        fireproximityprompt(obj)
                    end)

                    triggered = true
                    break
                end
            end
        end
    end

    -- Wait
    task.wait(0.8)

    -- Teleport back
    hrp.CFrame = CFrame.new(-338.11, 16.01, -5.19)

    humanoid.WalkSpeed = 59

    -- Noclip
    enableNoclip(character)

    -- Put player 10 studs above camera
    local camPos = camera.CFrame.Position
    hrp.CFrame = CFrame.new(camPos + Vector3.new(0, 10, 0))

end)
