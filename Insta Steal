-- Visual baseplate
local visualBaseplate = nil
local baseplateOutline = nil
local floatConnection = nil

local function createVisualBaseplate(position)
    if visualBaseplate then visualBaseplate:Destroy() end
    if baseplateOutline then baseplateOutline:Destroy() end
    if floatConnection then floatConnection:Disconnect() end
    
    visualBaseplate = Instance.new("Part")
    visualBaseplate.Name = "VisualBaseplate"
    visualBaseplate.Shape = Enum.PartType.Block
    visualBaseplate.Size = Vector3.new(4, 2, 4)
    visualBaseplate.Position = position
    visualBaseplate.Color = Color3.fromRGB(0, 0, 0)
    visualBaseplate.Transparency = 0.2
    visualBaseplate.CanCollide = false
    visualBaseplate.Anchored = true
    visualBaseplate.CFrame = CFrame.new(position)
    visualBaseplate.TopSurface = Enum.SurfaceType.Smooth
    visualBaseplate.BottomSurface = Enum.SurfaceType.Smooth
    visualBaseplate.Parent = workspace
    
    baseplateOutline = Instance.new("Part")
    baseplateOutline.Name = "BaseplateOutline"
    baseplateOutline.Shape = Enum.PartType.Block
    baseplateOutline.Size = Vector3.new(4.2, 2.2, 4.2)
    baseplateOutline.Position = position
    baseplateOutline.Color = Color3.fromRGB(255, 255, 255)
    baseplateOutline.Transparency = 0.3
    baseplateOutline.CanCollide = false
    baseplateOutline.Anchored = true
    baseplateOutline.CFrame = visualBaseplate.CFrame + Vector3.new(0, -0.1, 0)
    baseplateOutline.TopSurface = Enum.SurfaceType.Smooth
    baseplateOutline.BottomSurface = Enum.SurfaceType.Smooth
    baseplateOutline.Parent = workspace
    
    -- Floating animation
    local floatHeight = 0.5
    local floatSpeed = 2
    local time = 0
    
    floatConnection = RunService.Heartbeat:Connect(function(deltaTime)
        if visualBaseplate and visualBaseplate.Parent then
            time = time + deltaTime
            local floatOffset = math.sin(time * floatSpeed) * floatHeight
            visualBaseplate.CFrame = CFrame.new(position + Vector3.new(0, floatOffset, 0))
            if baseplateOutline and baseplateOutline.Parent then
                baseplateOutline.CFrame = visualBaseplate.CFrame + Vector3.new(0, -0.1, 0)
            end
        else
            if floatConnection then floatConnection:Disconnect() end
        end
    end)
end

