--// Instant prompts globally
ProximityPromptService.PromptShown:Connect(function(prompt)
    prompt.HoldDuration = 0
    prompt.RequiresLineOfSight = false
end)

--// Noclip
local noclipConnection

local function enableNoclip(character)
    if noclipConnection then
        noclipConnection:Disconnect()
    end

    noclipConnection = RunService.Stepped:Connect(function()
        for _, v in pairs(character:GetDescendants()) do
            if v:IsA("BasePart") then
                v.CanCollide = false
            end
        end
    end)
end

--// Trigger EVERY prompt in radius until one succeeds
local function triggerNearbyPrompts(hrp)
    local radius = 25
    local success = false

    while not success do
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("ProximityPrompt") and obj.Parent then

                local parentPart = obj.Parent

                if parentPart:IsA("BasePart") then
                    local distance = (hrp.Position - parentPart.Position).Magnitude

                    if distance <= radius then
                        obj.HoldDuration = 0
                        obj.RequiresLineOfSight = false

                        local worked = pcall(function()
                            fireproximityprompt(obj)
                        end)

                        if worked then
                            success = true
                            break
                        end
                    end
                end
            end
        end

        task.wait(0.05)
    end
end

--// Main
button.MouseButton1Click:Connect(function()

    local character = player.Character or player.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid")
    local hrp = character:WaitForChild("HumanoidRootPart")

    -- Equip first tool
    local backpack = player:WaitForChild("Backpack")
    local firstTool = backpack:FindFirstChildWhichIsA("Tool")

    if firstTool then
        humanoid:EquipTool(firstTool)

        -- Ensure equipped
        repeat
            task.wait()
        until character:FindFirstChild(firstTool.Name)
    end

    -- Teleport
    hrp.CFrame = CFrame.new(-338.11, 16.01, -5.19)

    humanoid.WalkSpeed = 29

    -- Trigger every prompt in radius
    triggerNearbyPrompts(hrp)

    -- Wait
    task.wait(0.8)

    -- Teleport back
    hrp.CFrame = CFrame.new(-338.11, 16.01, -5.19)

    humanoid.WalkSpeed = 59

    -- Enable noclip
    enableNoclip(character)

    -- Move 10 studs above camera
    local camPos = camera.CFrame.Position
    hrp.CFrame = CFrame.new(camPos + Vector3.new(0, 10, 0))

end)
