------------------------------------------------
-- 🖼️ FORCE IMAGE ON A GUI OBJECT
------------------------------------------------
local function applyImage(container, imageId)
	for _, obj in ipairs(container:GetDescendants()) do
		if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
			obj.Image = imageId
			obj.ImageTransparency = 0
		end
	end
end

------------------------------------------------
-- 🔧 CORE FIX FUNCTION
------------------------------------------------
local function clearAndBuild(item)
	local spacer = item:FindFirstChild("Spacer", true)
	if not spacer then return end

	local traits = spacer:FindFirstChild("Traits", true)
	if not traits then return end

	local template = traits:FindFirstChild("Template")
	if not template then return end

	-- ❗ STEP 1: FORCE FIX TEMPLATE ITSELF FIRST (THIS WAS YOUR BUG)
	for _, obj in ipairs(template:GetDescendants()) do
		if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
			obj.ImageTransparency = 0
			obj.Image = imageIds[1] -- default fallback image
		end
	end

	template.Visible = false

	-- remove old clones
	for _, v in ipairs(traits:GetChildren()) do
		if v:IsA("GuiObject") and v ~= template then
			v:Destroy()
		end
	end

	-- ❗ STEP 2: CLONE AFTER TEMPLATE IS FIXED
	for _, id in ipairs(imageIds) do
		local clone = template:Clone()
		clone.Parent = traits
		clone.Visible = true
		clone.BackgroundTransparency = 1

		-- ❗ STEP 3: FORCE APPLY IMAGE TO CLONE
		applyImage(clone, id)
	end
end

