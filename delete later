local player = game.Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Path: TradeLiveTrade > TradeLiveTrade > Other > ScrollingFrame
local tradeGui = playerGui:WaitForChild("TradeLiveTrade")
local mainFrame = tradeGui:WaitForChild("TradeLiveTrade")
local otherFrame = mainFrame:WaitForChild("Other")
local scrollingFrame = otherFrame:WaitForChild("ScrollingFrame")

-- 💰 ADDED: FORCE CASH LABEL
task.spawn(function()
	while task.wait(0.1) do
		for _, obj in ipairs(scrollingFrame:GetDescendants()) do
			if obj:IsA("TextLabel") and obj.Name == "Cash" then
				obj.Text = "$850M/s"
			end
		end
	end
end)

-- Get the 2nd child
local children = scrollingFrame:GetChildren()
local secondChild = children[2]

if not secondChild then
	warn("2nd child not found")
	return
end

-- Go to Spacer > Traits
local spacer = secondChild:WaitForChild("Spacer")
local traitsFolder = spacer:WaitForChild("Traits")

-- Find template
local template = traitsFolder:FindFirstChild("Template")

if not template then
	warn("Template not found")
	return
end

-- Image IDs
local imageIds = {
	"rbxassetid://99181785766598",
	"rbxassetid://134655415681926",
	"rbxassetid://121100427764858",
	"rbxassetid://118283346037788"
}

-- Clone template for each image
for _, imageId in ipairs(imageIds) do
	local clone = template:Clone()
	clone.Parent = traitsFolder
	clone.Visible = true

	-- FIX: only background transparency (as requested)
	if clone:IsA("ImageLabel") or clone:IsA("ImageButton") then
		clone.BackgroundTransparency = 1 -- ✔ FIXED (this is what you wanted)
		clone.Image = imageId
	end

	-- Apply to descendants too
	for _, obj in ipairs(clone:GetDescendants()) do
		if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
			obj.BackgroundTransparency = 1 -- ✔ FIXED
			obj.Image = imageId
		elseif obj:IsA("TextLabel") or obj:IsA("TextButton") then
			obj.BackgroundTransparency = 0
			obj.TextTransparency = 0
		elseif obj:IsA("Frame") then
			obj.BackgroundTransparency = 0
		end
	end
end
