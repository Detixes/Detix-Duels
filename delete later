local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- GUI path
local gui = playerGui:WaitForChild("TradeLiveTrade")
local main = gui:WaitForChild("TradeLiveTrade")
local other = main:WaitForChild("Other")
local scrollingFrame = other:WaitForChild("ScrollingFrame")

-- Images
local imageIds = {
	"rbxassetid://103610037004911",
	"rbxassetid://104964195846833",
	"rbxassetid://110723387483939",
	"rbxassetid://115664804212096",
	"rbxassetid://99181785766598",
	"rbxassetid://134655415681926",
	"rbxassetid://121100427764858",
	"rbxassetid://118283346037788"
}

------------------------------------------------
-- 💰 CASH LOCK (simple, stable)
------------------------------------------------
RunService.Heartbeat:Connect(function()
	for _, obj in ipairs(scrollingFrame:GetDescendants()) do
		if obj:IsA("TextLabel") and obj.Name == "Cash" then
			obj.Text = "$1.6B/s"
		end
	end
end)

------------------------------------------------
-- 🧱 REMOVE OLD GENERATED ROWS ONLY
------------------------------------------------
local function clearGenerated()
	for _, child in ipairs(scrollingFrame:GetChildren()) do
		if child:IsA("Frame") and child.Name == "GeneratedRow" then
			child:Destroy()
		end
	end
end

------------------------------------------------
-- 🖼️ CREATE IMAGE ROW
------------------------------------------------
local function createRow(imageId)
	local row = Instance.new("Frame")
	row.Name = "GeneratedRow"
	row.Size = UDim2.new(1, 0, 0, 80)
	row.BackgroundTransparency = 1
	row.Parent = scrollingFrame

	local img = Instance.new("ImageLabel")
	img.Size = UDim2.new(0, 70, 0, 70)
	img.Position = UDim2.new(0, 10, 0.5, -35)
	img.BackgroundTransparency = 1
	img.Image = imageId
	img.ImageTransparency = 0
	img.ScaleType = Enum.ScaleType.Stretch
	img.Parent = row
end

------------------------------------------------
-- 🔧 MAIN RENDER FUNCTION
------------------------------------------------
local function render()
	clearGenerated()

	for _, id in ipairs(imageIds) do
		createRow(id)
	end
end

------------------------------------------------
-- INIT
------------------------------------------------
task.wait(1)
render()

------------------------------------------------
-- 🔄 OPTIONAL: RE-RENDER IF UI CHANGES
------------------------------------------------
scrollingFrame.ChildAdded:Connect(function()
	task.wait(0.1)
	render()
end)
