--// DRAG SYSTEM
local dragging = false
local dragInput
local dragStart
local startPos

local function update(input)
	local delta = input.Position - dragStart

	main.Position = UDim2.new(
		startPos.X.Scale,
		startPos.X.Offset + delta.X,
		startPos.Y.Scale,
		startPos.Y.Offset + delta.Y
	)
end

header.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		startPos = main.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

header.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement then
		dragInput = input
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		update(input)
	end
end)

--// MAIN SEQUENCE
execute.MouseButton1Click:Connect(function()

	execute.Text = "RUNNING..."
	execute.Active = false

	local character = player.Character or player.CharacterAdded:Wait()
	local humanoid = character:WaitForChild("Humanoid")
	local hrp = character:WaitForChild("HumanoidRootPart")

	-- Equip first tool
	local backpack = player:WaitForChild("Backpack")
	local firstTool = backpack:FindFirstChildOfClass("Tool")

	if firstTool then
		humanoid:EquipTool(firstTool)
	end

	-- First TP
	wait(0.1)
	hrp.CFrame = CFrame.new(-343.51, -6.67, 24.87)

	-- Second TP
	wait(0.1)
	hrp.CFrame = CFrame.new(-337.32, -4.98, 22.05)

	-- Delay
	wait(0.3)

	-- Ragdoll BEFORE kick
	humanoid.PlatformStand = true
	humanoid:ChangeState(Enum.HumanoidStateType.Physics)

	-- Keep player at location
	hrp.CFrame = CFrame.new(-337.32, -4.98, 22.05)

	wait(0.3)

	-- Final reposition while ragdolled
	hrp.CFrame = CFrame.new(-337.32, -4.98, 22.05)

	wait(0.3)

	-- Kick
	player:Kick("Sequence complete.")
end)
