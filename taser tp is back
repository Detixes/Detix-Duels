--====================================================
-- DRAGGING WINDOW
--====================================================

local dragging = false
local dragStart
local startPos

header.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		startPos = main.Position
	end
end)

header.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = false
	end
end)

UIS.InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - dragStart

		main.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
end)

--====================================================
-- SLIDER LOGIC
--====================================================

local multiplier = 1
local sliding = false

local function updateSlider(input)
	local percent = math.clamp(
		(input.Position.X - sliderBG.AbsolutePosition.X) / sliderBG.AbsoluteSize.X,
		0,
		1
	)

	sliderFill.Size = UDim2.new(percent,0,1,0)
	knob.Position = UDim2.new(percent,0,0.5,0)

	-- 0.1x to 5x
	multiplier = math.floor((0.1 + (percent * 4.9)) * 10) / 10

	sliderTitle.Text = "Wait Multiplier: "..multiplier.."x"
end

knob.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		sliding = true
	end
end)

UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		sliding = false
	end
end)

UIS.InputChanged:Connect(function(input)
	if sliding and input.UserInputType == Enum.UserInputType.MouseMovement then
		updateSlider(input)
	end
end)

--====================================================
-- TELEPORT SEQUENCE
--====================================================

local running = false

local function waitScaled(time)
	task.wait(time * multiplier)
end

execute.MouseButton1Click:Connect(function()

	if running then
		return
	end

	running = true

	execute.Text = "RUNNING..."
	execute.Active = false

	local character = player.Character or player.CharacterAdded:Wait()
	local hrp = character:WaitForChild("HumanoidRootPart")

	-- TP #1
	hrp.CFrame = CFrame.new(-346.78, -6.88, 39.93)

	waitScaled(0.05)

	-- TP #2
	hrp.CFrame = CFrame.new(-299.96, 13.02, 34.53)

	waitScaled(0.05)

	-- TP #3
	hrp.CFrame = CFrame.new(-304.01, 13.02, 6.99)

	waitScaled(0.03)

	-- TP #4
	hrp.CFrame = CFrame.new(-303.69, 29.43, 7.47)

